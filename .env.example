# PROMETHEUS-X Environment Variables Template
# Copy this file to .env and fill in real values locally. NEVER commit .env.

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase (Backend) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=inspections

# --- Frontend (Vite public env vars - NEVER put service_role here) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- AI Engine / Hardware (RTX 3050 4GB VRAM) ---
AI_DEVICE=cuda
AI_USE_FP16=true
AI_MAX_CACHED_BANKS=2
MVTEC_DATASET_DIR=C:/path/to/mvtec_anomaly_detection

# --- Upload limits ---
# 15728640 = 15 MB (default). Increase if you upload larger images.
MAX_UPLOAD_BYTES=15728640
